# Vaultline Backend Configuration
# Copy this file to .env and update with your actual values

# ==================== DATABASE ====================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vaultline

# Enable SQL query logging (set to false in production)
DATABASE_ECHO=true


# ==================== JWT AUTHENTICATION ====================
# Secret key for signing JWT tokens
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: Change this in production!
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7

# JWT token algorithm
ALGORITHM=HS256

# Token expiration in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ==================== FILE STORAGE ====================
# Directory for storing encrypted files (relative to backend-integration/)
UPLOAD_DIR=uploads

# Maximum file size in bytes (104857600 = 100 MB)
MAX_FILE_SIZE=104857600


# ==================== SECURITY ====================
# Bcrypt rounds for password hashing (higher = more secure but slower)
BCRYPT_ROUNDS=12


# ==================== CORS ====================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# ==================== APPLICATION ====================
# Application name
APP_NAME=Vaultline Secure File Vault

# Debug mode (disable in production)
DEBUG=true
